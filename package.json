{
    "name": "mongoose-history-audit",
    "version": "1.0.0",
    "description": "Mongoose plugin that intercepts document changes and writes an audit trail (diff history) to a dedicated collection, with AsyncLocalStorage context for tracking who changed the data.",
    "keywords": [
        "mongoose",
        "mongodb",
        "mongo",
        "audit",
        "audit-log",
        "audit-trail",
        "history",
        "history-log",
        "changelog",
        "change-log",
        "diff",
        "deep-diff",
        "differences",
        "version",
        "revision",
        "track-changes",
        "plugin",
        "trail",
        "document",
        "schema",
        "nestjs",
        "fastify",
        "async-local-storage",
        "modified-by",
        "who-changed"
    ],
    "license": "MIT",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./nest": {
            "types": "./dist/nest.d.ts",
            "default": "./dist/nest.js"
        },
        "./fastify": {
            "types": "./dist/fastify.d.ts",
            "default": "./dist/fastify.js"
        }
    },
    "files": [
        "dist"
    ],
    "sideEffects": false,
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "make build",
        "typecheck": "make typecheck",
        "test": "make test",
        "test:cov": "make test",
        "badge": "make badge",
        "lint": "make lint",
        "lint:fix": "make lint-fix",
        "prettier": "make prettier",
        "check": "make check",
        "prepublishOnly": "make lint typecheck test build"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dm-kamaev/mongoose-history-audit.git"
    },
    "peerDependencies": {
        "mongoose": "^8.0.0 || ^9.0.0"
    },
    "peerDependenciesMeta": {
        "@nestjs/common": {
            "optional": true
        },
        "@nestjs/core": {
            "optional": true
        },
        "rxjs": {
            "optional": true
        }
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@nestjs/common": "^12.5.1",
        "@nestjs/core": "^12.5.1",
        "@nestjs/platform-express": "^12.5.1",
        "@nestjs/testing": "^12.6.0",
        "@swc/core": "^1.16.22",
        "@types/jest": "^30.0.0",
        "@types/node": "^26.6.6",
        "@types/supertest": "^7.2.1",
        "@typescript-eslint/eslint-plugin": "^8.73.0",
        "@typescript-eslint/parser": "^8.73.0",
        "@typescript/native": "npm:typescript@>=7.1.0-dev.20261009.1",
        "coverage-badges": "^1.0.7",
        "eslint": "^10.15.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-new-with-error": "^6.0.0",
        "eslint-plugin-prettier": "^5.5.7",
        "eslint-plugin-promise": "^7.3.0",
        "eslint-plugin-unused-imports": "^4.4.1",
        "fastify": "^5.12.8",
        "jest": "^30.5.2",
        "mongodb-memory-server": "^11.3.0",
        "mongoose": "^9.12.2",
        "prettier": "^3.10.1",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "supertest": "^7.3.2",
        "ts-jest": "^29.4.15",
        "typescript": "npm:@typescript/typescript6@^6.0.2"
    }
}
